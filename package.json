{
  "name": "triviacon-app",
  "version": "0.9.13",
  "description": "Portable dual-screen desktop app for hosting live trivia nights.",
  "main": "./out/main/index.js",
  "author": "Marcin \"Aluś\" Jędrecki",
  "homepage": "https://github.com/TriviaCon/triviacon",
  "license": "MIT",
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "//electron-binary": "Electron >=42 ships no postinstall and fetches its binary on first run of its own CLI. electron-vite resolves the binary path directly, so it never triggers that — without this prefix a fresh clone fails with 'Error: Electron uninstall'. It is a ~0.7s no-op once installed. Not in postinstall: CI only lints/tests/builds, and electron-builder downloads its own dist, so no CI job needs the binary.",
    "start": "install-electron && electron-vite preview",
    "dev": "install-electron && electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.33.0",
  "//engines.node": "Mirrors jsdom@30's supported range, which is the strictest floor in the tree. Electron 43 needs >=22.12. The <26 ceiling from PR #70 is gone: it existed because electron@35's postinstall (extract-zip@2.0.1) hung unpacking its binary on Node 26+, and Electron dropped that postinstall entirely in v42.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.0",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "adm-zip": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "i18next": "^26.4.0",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
